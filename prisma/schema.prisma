// SPOTCHU Prisma 스키마 (초안)
// 원천: docs/data-model.md · 용어: docs/glossary.md
// PostGIS는 마이그레이션 SQL로 활성화하고, 근처 검색은 raw SQL(ST_DWithin)로 처리한다(docs/tech-stack.md).
// 좌표 불변식: Spot.shooterLat/shooterLng = 촬영자가 서는 위치.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // 런타임: Neon 풀링(-pooler) 문자열 / 로컬 docker 문자열
  directUrl = env("DIRECT_URL") // 마이그레이션: Neon 다이렉트(비풀링) 문자열 / 로컬은 DATABASE_URL과 동일
}

// ---------- Enums ----------
enum Role {
  GUEST
  USER
  TRUSTED_USER
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  OFFICIAL
  USER_VERIFIED
  USER_REPORTED
  ESTIMATED
}

enum CollectionVisibility {
  PRIVATE
  LINK
}

enum SafetyTag {
  PRIVATE_PROPERTY
  RAILWAY
  ROADWAY
  BUSINESS
}

enum TimeOfDay {
  DAWN
  DAY
  SUNSET
  NIGHT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ReportTargetType {
  SPOT
  POST
}

enum ReportReason {
  WRONG_LOCATION
  COPYRIGHT
  PRIVACY_TRESPASS
  INAPPROPRIATE
}

enum ModerationType {
  NEW_SPOT
  REPORT
  OFFICIAL_CANDIDATE
  WORK_STILL_REQUEST
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
  HIDDEN
}

enum WorkType {
  ANIME
  MOVIE
  DRAMA
  OTHER
}

enum Country {
  KR
  JP
  TW
  HK
  TH
  SG
  FR
  GB
  US
  ES
}

enum SourcePlatform {
  INSTAGRAM
  THREADS
  YOUTUBE
  BLOG
  OTHER
}

// MVP 인앱 알림 3종(prd §20 · docs/features/13-notifications/rules.md). 유형 추가는 PRD 개정 필요.
enum NotificationType {
  BADGE_EARNED
  REPORT_REVIEWED
  SPOT_PROMOTED
}

// ---------- Auth.js ----------
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String? // 이메일/비밀번호 가입자만 값 존재(bcrypt). 소셜 전용은 null. 절대 응답에 노출 금지.
  name          String? // Auth.js 표준
  image         String? // Auth.js 표준
  nickname      String? @unique // 서비스 표시명(name과 별개). 중복 불가(대소문자 무시 검사는 서버액션에서).
  avatarUrl     String?
  country       String? // 소속 국가(가입/설정에서 지정). lib/cities-geo COUNTRY_META의 2글자 id(kr·jp…). 게시물에 국기 표시.
  role          Role      @default(USER)
  isTrusted     Boolean   @default(false)
  // 동의 이력 (한국 위치정보법 대응)
  agreedTermsAt    DateTime?
  agreedPrivacyAt  DateTime?
  agreedLocationAt DateTime?
  birthYear        Int?
  createdAt     DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  collections Collection[]
  posts       Post[]
  likes       Like[]
  checkIns    CheckIn[]
  badges      UserBadge[]
  reportedSpots Spot[]    @relation("SpotCreatedBy")
  reports     Report[]
  notifications Notification[]
  spotViews   SpotView[]
  workViews   WorkView[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain ----------
model City {
  id          String  @id @default(cuid())
  name        String
  nameEn      String?
  country     Country
  centerLat   Float
  centerLng   Float
  defaultZoom Int     @default(13)
  isActive    Boolean @default(true)

  spots       Spot[]
  collections Collection[]
}

model Category {
  id        String @id @default(cuid())
  key       String @unique
  label     String
  sortOrder Int    @default(0)

  spots Spot[]
}

model Spot {
  id         String             @id @default(cuid())
  name       String
  categoryId String
  cityId     String
  // 불변식: 촬영자가 서는 위치
  shooterLat Float
  shooterLng Float
  coverImageUrl String? // 대표 이미지(없으면 앱에서 그라디언트 폴백). CC 이미지면 아래 출처표기 필수
  imageAuthor   String? // CC 저작자
  imageLicense  String? // 예: "CC BY-SA 4.0"
  imageSource   String? // 원본 파일 페이지 URL(Wikimedia 등)
  subject    String
  verificationStatus VerificationStatus @default(USER_REPORTED)
  createdById String?

  // 선택
  subjectLat  Float?
  subjectLng  Float?
  bearing     Float?
  addressCached String?
  access      String?
  tip         String?
  rating      Float? // 평점(표시용)
  subtitle    String? // 부제(지역·시간대 요약, 표시용)
  angle       String? // 각도 가이드 텍스트(표시용)
  infoSource  String? // 정보 출처 URL(리서치 반영 스팟)
  timeOfDay   TimeOfDay[]
  season      String?
  lens        String?
  difficulty  Difficulty?
  crowdedness String?
  caution     String?
  checkinRadiusM Int      @default(100)

  // 안전
  safetyTags       SafetyTag[]
  isBlockedHighRisk Boolean  @default(false)

  // 파생 집계 캐시
  saveCount          Int @default(0)
  checkinCount       Int @default(0)
  uniqueCheckinCount Int @default(0)
  likeSum            Int @default(0)

  // i18n (후속)
  nameJa    String?
  subjectJa String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  Category @relation(fields: [categoryId], references: [id])
  city      City     @relation(fields: [cityId], references: [id])
  createdBy User?    @relation("SpotCreatedBy", fields: [createdById], references: [id])
  works     SpotWork[]
  items     CollectionItem[]
  posts     Post[]
  checkIns  CheckIn[]
  leads     SpotLead[]

  @@index([cityId])
  @@index([categoryId])
  @@index([verificationStatus])
}

model Work {
  id       String   @id @default(cuid())
  title    String
  titleEn  String?
  type     WorkType
  coverImageUrl String?
  description   String?

  spots SpotWork[]
}

model SpotWork {
  id        String  @id @default(cuid())
  spotId    String
  workId    String
  episode   String?
  sceneNote String?

  spot Spot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([spotId, workId])
}

model Collection {
  id          String               @id @default(cuid())
  ownerId     String
  title       String
  description String?
  visibility  CollectionVisibility @default(PRIVATE)
  isOfficial  Boolean              @default(false)
  isDefault   Boolean              @default(false)
  cityId      String?
  coverImageUrl String?
  createdAt   DateTime             @default(now())

  owner User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  city  City?            @relation(fields: [cityId], references: [id])
  items CollectionItem[]
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  spotId       String
  order        Int      @default(0)
  day          Int? // nullable — 후속 날짜별 일정 확장 여지
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  spot       Spot       @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@unique([collectionId, spotId])
}

model Post {
  id             String   @id @default(cuid())
  authorId       String
  spotId         String // 스팟 필수 연결
  caption        String?
  isVerifiedShot Boolean  @default(false)
  createdAt      DateTime @default(now())

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  spot   Spot        @relation(fields: [spotId], references: [id], onDelete: Cascade)
  images PostImage[]
  likes  Like[]

  @@index([spotId])
  @@index([authorId])
}

model PostImage {
  id     String @id @default(cuid())
  postId String
  url    String
  order  Int    @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model CheckIn {
  id             String   @id @default(cuid())
  userId         String
  spotId         String
  deviceAccuracyM Float?
  isMockSuspected Boolean @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  spot Spot @relation(fields: [spotId], references: [id], onDelete: Cascade)

  // 스팟당 방문 완료는 최초 1회 unique (재인증 쿨다운은 애플리케이션 규칙)
  @@unique([userId, spotId])
  @@index([spotId])
}

model Badge {
  id          String @id @default(cuid())
  key         String @unique
  type        String // CITY | PILGRIMAGE_COMPLETE | FIRST_REPORTER
  label       String
  description String?
  iconUrl     String?
  criteria    Json?

  users UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  context   String   @default("") // cityId/workId 등 구분자
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId, context])
}

model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     ReportReason
  memo       String?
  createdAt  DateTime         @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
}

model ModerationItem {
  id         String           @id @default(cuid())
  type       ModerationType
  status     ModerationStatus @default(PENDING)
  refType    String
  refId      String
  assigneeId String?
  note       String?
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([type])
}

// 인앱 알림 — 소유자(userId) 스코프. 표시 문구는 type+참조 대상명으로 서버 조합(별도 저장 안 함).
// 딥링크 대상은 (refType, refId): SPOT→스팟 상세, BADGE→프로필 배지 (docs/features/13-notifications).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  refType   String? // "SPOT" | "BADGE"
  refId     String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

// 외부 시딩 리드 — ⚠️ 원본 이미지 저장 금지, 좌표·출처 메타만 (docs/features/12-policies)
model SpotLead {
  id             String         @id @default(cuid())
  sourceUrl      String
  sourcePlatform SourcePlatform
  placeName      String?
  lat            Float?
  lng            Float?
  note           String?
  status         ModerationStatus @default(PENDING)
  promotedSpotId String?
  createdAt      DateTime         @default(now())

  promotedSpot Spot? @relation(fields: [promotedSpotId], references: [id])
}

// 스팟 조회 이벤트 — 퍼널 '발견·조회' 단계 산출용(설계: docs/features/14-metrics-analytics/pipeline-design.md).
// Phase 1: 로그인 유저만, 사용자·스팟·일 1회 디듀프. 원시 좌표·PII 미저장(prd §23) — 행 사실만.
// 계정 삭제 시 함께 정리되도록 User에 onDelete:Cascade(타 유저 데이터와 동일 규칙). 보존 프루닝은 Phase 2.
model SpotView {
  id        String   @id @default(cuid())
  spotId    String
  userId    String
  source    String? // feed | map | search | collection | work | direct
  day       String // YYYY-MM-DD (일 단위 디듀프 키)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotId, day])
  @@index([createdAt])
  @@index([spotId])
}

// 작품 조회 이벤트 — 콘텐츠 관심 신호(어느 작품을 더 깊게 채울지 판단용). 퍼널 '발견'과 별개
// (작품 조회 ≠ 스팟 발견). SpotView와 동일 규칙: 로그인만, 유저·작품·일 1회 디듀프, PII 미저장,
// User onDelete:Cascade, 90일 보존 프루닝. source 없음(작품은 채널 귀인 불필요).
model WorkView {
  id        String   @id @default(cuid())
  workId    String
  userId    String
  day       String // YYYY-MM-DD (일 단위 디듀프 키)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workId, day])
  @@index([createdAt])
  @@index([workId])
}
