{
  "name": "spotchu",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "hook:format": "prettier --write --cache app lib components",
    "hook:typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "import:leads": "tsx scripts/import-leads.ts",
    "research": "tsx scripts/research-orchestrator.ts",
    "research:daily": "tsx scripts/research-orchestrator.ts daily",
    "research:country": "tsx scripts/research-orchestrator.ts country",
    "research:verify": "tsx scripts/research-orchestrator.ts verify",
    "research:global": "tsx scripts/research-orchestrator.ts global",
    "research:status": "tsx scripts/research-orchestrator.ts status",
    "research:doctor": "tsx scripts/research-orchestrator.ts doctor",
    "research:summary": "tsx scripts/research-orchestrator.ts summary",
    "postinstall": "prisma generate && node scripts/copy-cesium-assets.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@prisma/client": "^6",
    "@vis.gl/react-google-maps": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "cesium": "^1.144.0",
    "cloudinary": "^2.11.0",
    "cobe": "^2.0.1",
    "globe.gl": "^2.46.2",
    "lucide-react": "^1.34.0",
    "next": "^15",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19",
    "react-dom": "^19",
    "resend": "^6.24.0",
    "three": "^0.185.1",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "^15",
    "postcss": "^8",
    "prettier": "^3",
    "prisma": "^6",
    "tailwindcss": "^3",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^2"
  }
}
