# SPOTCHU 환경 변수 예시 — 실제 값은 .env.local(gitignore)에 둔다.

# Database (PostgreSQL + PostGIS)
# 로컬(docker-compose 기본값): DATABASE_URL·DIRECT_URL 동일하게.
DATABASE_URL="postgresql://spotchu:spotchu@localhost:5432/spotchu?schema=public"
DIRECT_URL="postgresql://spotchu:spotchu@localhost:5432/spotchu?schema=public"
# 배포(Neon 무료): DATABASE_URL=풀링(...-pooler...&pgbouncer=true), DIRECT_URL=다이렉트(-pooler 없는 문자열). 자세히는 DEPLOY.md.

# 페이지 데이터 소스: 미설정=목업(실제 스팟 반영됨, DB 없이 데모 가능) / "db"=실 DB
DATA_SOURCE=""

# Auth.js — AUTH_SECRET 생성: `npx auth secret` 또는 `openssl rand -base64 32`
AUTH_SECRET=""
# 실제 소셜 로그인 활성화(시크릿 세팅 완료 후 "true"). 기본 false면 로그인 화면은 데모 플로우.
NEXT_PUBLIC_AUTH_ENABLED="false"
# 카카오
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""
# 네이버
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""
# 구글
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# 애플
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Cloudflare R2 (S3 호환)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
