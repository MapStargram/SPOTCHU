# SPOTCHU 환경 변수 예시 — 실제 값은 .env.local(gitignore)에 둔다.

# Database (PostgreSQL + PostGIS) — docker-compose 기본값과 일치
DATABASE_URL="postgresql://spotchu:spotchu@localhost:5432/spotchu?schema=public"

# Auth.js — AUTH_SECRET 생성: `npx auth secret` 또는 `openssl rand -base64 32`
AUTH_SECRET=""
# 카카오
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""
# 구글
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# 애플
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Cloudflare R2 (S3 호환)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
