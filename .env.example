# SPOTCHU 환경 변수 예시 — 실제 값은 .env.local(gitignore)에 둔다.

# Database (PostgreSQL + PostGIS)
# 로컬(docker-compose 기본값): DATABASE_URL·DIRECT_URL 동일하게.
DATABASE_URL="postgresql://spotchu:spotchu@localhost:5432/spotchu?schema=public"
DIRECT_URL="postgresql://spotchu:spotchu@localhost:5432/spotchu?schema=public"
# 배포(Neon 무료): DATABASE_URL=풀링(...-pooler...&pgbouncer=true), DIRECT_URL=다이렉트(-pooler 없는 문자열). 자세히는 DEPLOY.md.

# 페이지 데이터 소스: 미설정=목업(실제 스팟 반영됨, DB 없이 데모 가능) / "db"=실 DB
DATA_SOURCE=""

# Auth.js — AUTH_SECRET 생성: `npx auth secret` 또는 `openssl rand -base64 32`
AUTH_SECRET=""
# 실제 소셜 로그인 활성화(시크릿 세팅 완료 후 "true"). 기본 false면 로그인 화면은 데모 플로우.
NEXT_PUBLIC_AUTH_ENABLED="false"
# 활성화 시 로그인 화면에 표시할 provider(쉼표구분). 예: "google" 또는 "google,kakao,naver"
NEXT_PUBLIC_AUTH_PROVIDERS="google"
# 카카오
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""
# 네이버
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""
# 구글
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# 애플
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# 이메일/비밀번호 로그인 + 메일 발송(이메일 인증·비밀번호 재설정) — Resend https://resend.com 무료 티어
RESEND_API_KEY=""
# 발신 주소(도메인 인증 전에는 onboarding@resend.dev 로 테스트 가능)
EMAIL_FROM="SPOTCHU <onboarding@resend.dev>"
# 메일 링크 절대주소용 앱 URL(예: https://spotchu-web.vercel.app / 로컬 http://localhost:3000)
APP_URL="http://localhost:3000"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Cloudinary (이미지 업로드/CDN) — https://cloudinary.com 무료(25GB)·카드 불필요
# 대시보드 > Product Environment Credentials 에서 확인.
# CLOUD_NAME/API_KEY/API_SECRET은 서버 전용 — 절대 클라이언트 노출 금지.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# 클라이언트 노출용(URL 검증에 쓰는 공개값 = 클라우드 이름). 노출 무방.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
